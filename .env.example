# Copy to .env for local tooling, or use antarr_demo/settings/local.py for Django.
# Never commit real secrets.

# Development overrides (optional — dev.py has safe defaults)
# DJANGO_DEBUG=True

# Production (required unless set in settings/local.py)
# DJANGO_SECRET_KEY=change-me
# DJANGO_ALLOWED_HOSTS=example.com,www.example.com

# Production database (optional; defaults to SQLite in development)
# DATABASE_URL=postgres://user:password@localhost:5432/antarr_demo

# WorkOS AuthKit (required for the landlord portal)
# WORKOS_API_KEY=sk_...
# WORKOS_CLIENT_ID=client_...

# Production transport security (enabled by default)
# DJANGO_SECURE_SSL_REDIRECT=True
# DJANGO_SECURE_HSTS_SECONDS=31536000
